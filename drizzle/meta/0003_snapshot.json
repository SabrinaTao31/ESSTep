      "name": "project_access",
      "isExisting": false,
      "definition": "\n SELECT project,email,role,status FROM project_members\n UNION ALL SELECT p.id,p.student,'student','accepted' FROM projects p WHERE p.student!='' AND NOT EXISTS(SELECT 1 FROM project_members m WHERE m.project=p.id AND m.email=p.student)\n UNION ALL SELECT p.id,p.mentor,'mentor','accepted' FROM projects p WHERE p.mentor!='' AND NOT EXISTS(SELECT 1 FROM project_members m WHERE m.project=p.id AND m.email=p.mentor)\n"
    }
